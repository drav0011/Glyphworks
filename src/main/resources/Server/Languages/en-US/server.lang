items.Glyphworks_Crafting_Bench_Salvage.name=Automated Salvage Bench
items.Glyphworks_Crafting_Bench_Salvage.description=Can be used to break down some items into base materials.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_Tannery.name=Automated Tannery
items.Glyphworks_Crafting_Bench_Tannery.description=Used to process raw hides into leather.\nUpgrading reduces processing times and increases storage capacity.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_Weapon.name=Automated Weapon Bench
items.Glyphworks_Crafting_Bench_Weapon.description=Used to fashion basic weaponry.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_WorkBench.name=Automated Workbench
items.Glyphworks_Crafting_Bench_WorkBench.description=A workstation enabling the crafting of more complex tools and items.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.\n\n<i>No artisan is born a creator. Even Avatars need time to hone their craft, particularly when bound by the rules of another's domain.</i>

# Fluid network 
items.Glyphworks_Fluid_Tank.name=Fluid Tank
items.Glyphworks_Fluid_Tank.description=Stores up to 16,000 mL of any fluid.
items.Glyphworks_Fluid_Pipe.name=Fluid Pipe
items.Glyphworks_Fluid_Pipe.description=Transports fluids between network nodes. Connects \nAutomatically to adjacent pipes.
items.Glyphworks_Fluid_Placer.name=Fluid Placer
items.Glyphworks_Fluid_Placer.description=Places the stored fluid as a block directly below.
items.Glyphworks_Fluid_Remover.name=Fluid Remover
items.Glyphworks_Fluid_Remover.description=Collects the fluid block directly below and moves it into the network.
items.Glyphworks_Fluid_Mana.name=Liquid Mana
items.Glyphworks_Fluid_Mana.description=<i>The universe's source of power</i>
items.Glyphworks_Fluid_Source.name=Fluid Source
items.Glyphworks_Fluid_Source.description=Generates an infinite supply of fluid. Intended for creative use.
items.Glyphworks_Fluid_Sink.name=Fluid Sink
items.Glyphworks_Fluid_Sink.description=Destroys any fluid piped into it.

# Item network
items.Glyphworks_Item_Container.name=Item Container
items.Glyphworks_Item_Container.description=Stores up to 20 item stacks.
items.Glyphworks_Item_Pipe.name=Item Pipe
items.Glyphworks_Item_Pipe.description=Transports items between network nodes. Connects \nAutomatically to adjacent pipes.
items.Glyphworks_Item_Source.name=Item Source
items.Glyphworks_Item_Source.description=Generates an infinite supply of any item. Intended for creative use. Press F to set the item it produces. Right click to inspect
items.Glyphworks_Item_Sink.name=Item Sink
items.Glyphworks_Item_Sink.description=Destroys any item piped into it.
items.Glyphworks_Item_Inserter.name=Item Inserter
items.Glyphworks_Item_Inserter.description=Pushes items from the network into the block directly below.
items.Glyphworks_Item_Extractor.name=Item Extractor
items.Glyphworks_Item_Extractor.description=Pulls items out of the block directly below and moves them into the network.
items.Glyphworks_Item_Picker.name=Item Picker
items.Glyphworks_Item_Picker.description=Collects items dropped on the ground within a 3-block radius.
items.Glyphworks_Item_Dropper.name=Item Dropper
items.Glyphworks_Item_Dropper.description=Ejects items from the network as dropped entities on the ground.
items.Glyphworks_Block_Miner.name=Block Miner
items.Glyphworks_Block_Miner.description=Automatically mines the block directly below and <color is="#FF0000">output</color>s the drops.
items.Glyphworks_Block_Placer.name=Block Placer
items.Glyphworks_Block_Placer.description=Places blocks from the network directly below itself.

