items.Glyphworks_Crafting_Bench_Armour.name=Automated Armour Bench
items.Glyphworks_Crafting_Bench_Armour.description=Used to craft basic armor.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
## Builders?
items.Glyphworks_Crafting_Bench_Furniture.name=Automated Furniture Bench
items.Glyphworks_Crafting_Bench_Furniture.description=Used to craft furniture, storage, and decorative items to personalize your home.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_Campfire.name=Automated Campfire
items.Glyphworks_Crafting_Bench_Campfire.description=Cook basic meals.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.\n\n<i>To many an adventurer, the humble campfire is all it takes to declare a place "home." Unshakeable bonds can be forged while basking in its warmth and all great tales have sparked from its embers.</i>
items.Glyphworks_Crafting_Bench_Cooking.name=Automated Cooking Bench
items.Glyphworks_Crafting_Bench_Cooking.description=A built-in kitchen that can be used to make advanced dishes.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_Farming.name=Automated Farming Bench
items.Glyphworks_Crafting_Bench_Farming.description=Used to craft farming accessories and animal feed.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
items.Glyphworks_Crafting_Bench_Furnace.name=Automated Furnace
items.Glyphworks_Crafting_Bench_Furnace.description=Used to process ore into metal bars.\nUpgrading reduces smelting times and increases storage capacity.\nAutomatically pulls <color is="#47D500">input</color> and pushes <color is="#FF0000">output</color>.\nRequires liquid <color is="#35c1f1">mana</color>.
